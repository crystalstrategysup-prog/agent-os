{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos.setup-index/v1",
  "title": "AgentOS public setup scenario index",
  "type": "object",
  "required": ["schema", "version", "scenarios"],
  "properties": {
    "schema": {"const": "agentos.setup-index/v1"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "summary", "implementation_status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 120},
          "summary": {"type": "string", "minLength": 1, "maxLength": 300},
          "implementation_status": {"enum": ["guide_only", "adapter_available"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
