{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "objective",
    "why",
    "outcome",
    "scope_in",
    "scope_out",
    "constraints",
    "operation",
    "authority",
    "change_kind",
    "write_paths",
    "acceptance",
    "checks"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "why": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "scope_in": {
      "type": "string",
      "minLength": 1
    },
    "scope_out": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "change_kind": {
      "enum": [
        "observe",
        "docs",
        "implementation",
        "architecture",
        "integration",
        "data",
        "infrastructure",
        "security",
        "release",
        "incident"
      ]
    },
    "write_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
          "id",
          "criterion",
          "checks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        }
      },
      "minItems": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
          "id",
          "argv"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "timeout": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          }
        }
      },
      "minItems": 1
    }
  }
}
