  "schema": "agentos.cli-contract/v1",
  "standard_exit_codes": {
    "0": "completed command or plan",
    "2": "blocked, validation failure or argparse error"
  },
  "refusal_recovery": {
    "schema": "agentos.refusal-recovery-request/v1",
    "permit_schema": "agentos.refusal-recovery-permit/v1",
    "receipt_schema": "agentos.refusal-recovery-receipt/v1",
    "new_workflow_status": "RECOVERY_REQUIRED",
    "new_document_max_bytes": 16384,
    "existing_metadata_max_bytes": 4194304,
    "observation_max_age_seconds": 900,
    "authority_truth": "Owner-attested local evidence; not cryptographically authenticated by core",
    "resume": "RECOVERY_REQUIRED-specific enter guard checks committed B and exact project/task/revision/op/newbinding under project→turn locks BEFORE all answers/docs/status writes",
    "legacy": "Existing normal gates, predicates, acceptance, source/scan/capacity unchanged outside pending/newstatus branch",
    "pending_signal": "Atomic reserved directory + identity before preparation; complete journal afterward; either signal blocks all ordinary require_clear callsites. IncompleteUNKNOWN is never auto-cleared.",
    "task_metadata_entry_max": 256,
    "journal_admission": "Bounded one exact task metadata directory names, producer handoff-{profile}-{fingerprint}.json and any uncertain handoff-shaped entry refuse before recovery writes; no source/library discovery",
    "schemas": "Bundled task/event enums and typed recovery contract now include actual A/C outputs; old enum values/bounds preserved",
    "typed_revision": "Strict int permit and receipt revision, bool/float do not equal int1",
    "staged_semantics": "Canonical typed parsed JSON equality, not Python dict equality, for ALL task/turn/ack/advance postimages before first targetwrite. Invalid aliases preserve targets/reservation/journal; keyorder/whitespace allowed."
  }
}
