{
  "$id": "https://github.com/crystalstrategysup-prog/agent-os/schemas/indexed-handoff-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "decisions": {
      "additionalProperties": false,
      "properties": {
        "checked": {
          "const": true
        },
        "items": {
          "items": {
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "checked",
        "items"
      ],
      "type": "object"
    },
    "deliverables": {
      "items": {
        "properties": {
          "asset_id": {
            "minLength": 1,
            "type": "string"
          },
          "media_type": {
            "minLength": 1,
            "type": "string"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "preservation": {
            "enum": [
              "embedded",
              "external_pinned",
              "external_live",
              "unavailable"
            ]
          },
          "ref": {
            "additionalProperties": false,
            "properties": {
              "locator": {
                "pattern": "^aos://[^/]+/objects/sha256/[0-9a-f]{64}$",
                "type": "string"
              },
              "media_type": {
                "minLength": 1,
                "type": "string"
              },
              "object_id": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              "size_bytes": {
                "maximum": 16777216,
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "object_id",
              "locator",
              "size_bytes",
              "media_type"
            ],
            "type": "object"
          },
          "required": {
            "type": "boolean"
          },
          "source_ref": {
            "type": "object"
          }
        },
        "required": [
          "asset_id",
          "path",
          "preservation",
          "required",
          "media_type"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "entity": {
      "additionalProperties": false,
      "properties": {
        "approval": {
          "additionalProperties": false,
          "properties": {
            "agent_checked": {
              "const": true
            },
            "evidence_ids": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            "required": {
              "type": "boolean"
            },
            "user_confirmed": {
              "type": "boolean"
            }
          },
          "required": [
            "required",
            "agent_checked",
            "user_confirmed",
            "evidence_ids"
          ],
          "type": "object"
        },
        "entity_id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "work",
            "stage",
            "project"
          ]
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "required_children": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "scope_revision": {
          "minimum": 1,
          "type": "integer"
        },
        "state": {
          "enum": [
            "active",
            "blocked",
            "verifying",
            "completed",
            "cancelled"
          ]
        }
      },
      "required": [
        "entity_id",
        "kind",
        "parent_id",
        "state",
        "scope_revision",
        "required_children",
        "approval"
      ],
      "type": "object"
    },
    "evidence": {
      "items": {
        "properties": {
          "asset_id": {
            "minLength": 1,
            "type": "string"
          },
          "media_type": {
            "minLength": 1,
            "type": "string"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "preservation": {
            "enum": [
              "embedded",
              "external_pinned",
              "external_live",
              "unavailable"
            ]
          },
          "ref": {
            "additionalProperties": false,
            "properties": {
              "locator": {
                "pattern": "^aos://[^/]+/objects/sha256/[0-9a-f]{64}$",
                "type": "string"
              },
              "media_type": {
                "minLength": 1,
                "type": "string"
              },
              "object_id": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              "size_bytes": {
                "maximum": 16777216,
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "object_id",
              "locator",
              "size_bytes",
              "media_type"
            ],
            "type": "object"
          },
          "required": {
            "type": "boolean"
          },
          "source_ref": {
            "type": "object"
          }
        },
        "required": [
          "asset_id",
          "path",
          "preservation",
          "required",
          "media_type"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "facets": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "language": {
          "minLength": 1,
          "type": "string"
        },
        "project_id": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "related_entity_id": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "result_type": {
          "minLength": 1,
          "type": "string"
        },
        "stage_id": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "summary": {
          "minLength": 1,
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "topic_id": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "title",
        "summary",
        "result_type",
        "language",
        "project_id",
        "stage_id",
        "topic_id",
        "related_entity_id",
        "aliases"
      ],
      "type": "object"
    },
    "handoff_id": {
      "minLength": 1,
      "type": "string"
    },
    "handoff_ref": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "pattern": "^aos://[^/]+/objects/sha256/[0-9a-f]{64}$",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "type": "string"
        },
        "object_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
