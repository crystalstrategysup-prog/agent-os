      "minItems": 1,
      "type": "array"
    },
    "open_items": {
      "additionalProperties": false,
      "properties": {
        "checked": {
          "const": true
        },
        "items": {
          "items": {
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "checked",
        "items"
      ],
      "type": "object"
    },
    "permissions": {
      "additionalProperties": false,
      "properties": {
        "checked": {
          "const": true
        },
        "items": {
          "items": {
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "checked",
        "items"
      ],
      "type": "object"
    },
    "privacy": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "const": "scope_private"
        },
        "redaction": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "retention": {
          "const": "owner_policy_no_automatic_deletion"
        },
        "scope_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "scope_id",
        "classification",
        "retention",
        "redaction"
      ],
      "type": "object"
    },
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "recovery": {
      "additionalProperties": false,
      "properties": {
        "dependencies": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "dependency_id": {
                "minLength": 1,
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "status": {
                "enum": [
                  "embedded",
                  "unknown",
                  "unavailable"
                ]
              },
              "asset_id": {
                "minLength": 1,
                "type": "string"
              },
              "ref": {
                "additionalProperties": false,
                "properties": {
                  "locator": {
                    "pattern": "^aos://[^/]+/objects/sha256/[0-9a-f]{64}$",
                    "type": "string"
                  },
                  "media_type": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "object_id": {
                    "pattern": "^sha256:[0-9a-f]{64}$",
                    "type": "string"
                  },
                  "size_bytes": {
                    "maximum": 16777216,
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "object_id",
                  "locator",
                  "size_bytes",
                  "media_type"
                ],
                "type": "object"
              }
            },
            "required": [
              "dependency_id",
              "required",
              "status"
            ],
            "type": "object",
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "embedded"
                    }
                  }
                },
                "then": {
                  "required": [
                    "asset_id",
                    "ref"
                  ]
                },
                "else": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "asset_id"
                        ]
                      },
                      {
                        "required": [
                          "ref"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          },
          "type": "array"
        },
        "first_assets": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "level": {
          "enum": [
            "self_contained",
            "external_required",
            "summary_only"
          ]
        },
        "next_step": {
          "minLength": 1,
          "type": "string"
        },
        "not_restored": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "read_only_checks": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "asset_id": {
                "minLength": 1,
                "type": "string"
              },
              "kind": {
                "const": "sha256"
              }
            },
            "required": [
              "asset_id",
              "kind"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "required_access": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "level",
        "first_assets",
        "dependencies",
        "required_access",
        "not_restored",
        "next_step",
        "read_only_checks"
      ],
      "type": "object"
    },
    "results": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "criterion_id": {
            "minLength": 1,
            "type": "string"
          },
          "deliverable_ids": {
            "items": {
              "minLength": 1,
              "type": "string"
