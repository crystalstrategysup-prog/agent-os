          "criterion_id",
          "status",
          "evidence_ids",
          "deliverable_ids"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema": {
      "const": "agentos.indexed-handoff/v1"
    },
    "schema_version": {
      "const": 1
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "boundaries": {
          "minLength": 1,
          "type": "string"
        },
        "change_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "criteria": {
          "items": {
            "additionalProperties": false,
