          "type": "array"
        },
        "objective": {
          "minLength": 1,
          "type": "string"
        },
        "request_evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "objective",
        "boundaries",
        "criteria",
        "request_evidence_ids",
        "change_refs"
      ],
      "type": "object"
    },
    "serializer": {
      "const": "utf8-sorted-keys-integer-json/v1"
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema",
    "schema_version",
    "serializer",
    "library_id",
    "handoff_id",
    "created_at",
    "supersedes",
    "producer",
    "entity",
    "scope",
    "facets",
    "deliverables",
    "results",
    "decisions",
    "permissions",
    "open_items",
    "evidence",
    "recovery",
