{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crystalstrategy.example/agentos.profile-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "scope", "host_binding", "entries"],
  "properties": {
    "schema": {"const": "agentos.profile/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,79}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 80},
    "scope": {"enum": ["owner", "host", "project", "custom"]},
    "host_binding": {"type": ["string", "null"], "maxLength": 200},
    "entries": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key", "kind", "value", "source", "observed_at", "status"],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,99}$"},
          "kind": {"enum": ["fact", "preference", "instruction"]},
          "value": {"type": "string", "minLength": 1, "maxLength": 2000},
          "source": {"type": "string", "minLength": 1, "maxLength": 300},
          "observed_at": {"type": "string", "format": "date-time"},
          "status": {"enum": ["OWNER_CONFIRMED", "LIVE_OBSERVED", "DOCUMENTED", "INFERRED"]}
        }
      }
    }
  }
}
