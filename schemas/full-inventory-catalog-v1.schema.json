{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-os.full-inventory-catalog/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "catalog_id", "projects"],
  "properties": {
    "schema": {"const": "agent-os.full-inventory-catalog/v1"},
    "catalog_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "projects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project_id", "root"],
        "properties": {
          "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "host_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
          "root": {"type": "string", "minLength": 1},
          "policy_paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 512}
          },
          "roadmap_paths": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 512}
          },
          "enabled": {"type": "boolean"}
        }
      }
    }
  }
}
