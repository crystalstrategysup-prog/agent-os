#!/usr/bin/env python3
"""Read-only exact-pinned image catalog check; no Docker run/build."""
import json
import argparse
import runpy
from pathlib import Path
import sys
root, project = runpy.run_path(str(Path(__file__).with_name('_bootstrap.py')))['prepare'](__file__)
sys.path.insert(0, str(root))
from tools.function_extractor.runner.environment_catalog import discover
p = argparse.ArgumentParser(description=__doc__)
p.add_argument('--source-root', type=Path, default=project)
a = p.parse_args()
value = discover(a.source_root)
print(json.dumps(value, ensure_ascii=False, sort_keys=True))
raise SystemExit(0 if value["status"] == "EXISTING_QUALIFIED" else 2)
