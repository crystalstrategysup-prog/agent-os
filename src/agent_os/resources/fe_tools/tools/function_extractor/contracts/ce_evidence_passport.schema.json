{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "ce-evidence.passport/v1"
    },
    "version": {
      "const": 1
    },
    "status": {
      "const": "OBSERVED"
    },
    "evidence_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "source_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "contract_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "fixture_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "observed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "delivery_state": {
            "enum": [
              "queued",
              "sending",
              "sent",
              "delivered",
              "failed",
              "unknown",
              "partial",
              "retry_wait",
              "not_started",
              "not_requested",
              "disabled",
              "unobserved"
            ]
          },
          "test_verdict": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN"
            ]
          },
          "diagnostic_status": {
            "enum": [
              "DRIFT",
              "CONFORMANT",
              "INCOMPLETE"
            ]
          }
        },
        "required": [
          "case_id",
          "delivery_state",
          "test_verdict",
          "diagnostic_status"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "drift": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "rule_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "classification": {
            "enum": [
              "CODE_BUG",
              "CONTRACT_GAP",
              "DOCUMENTATION_DRIFT",
              "ENVIRONMENT_DEPENDENT",
              "EXPECTED_FAILURE",
              "UNDETERMINED"
            ]
          }
        },
        "required": [
          "case_id",
          "rule_id",
          "classification"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "proposed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "const": "PROPOSED"
          },
          "rule_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "action": {
            "const": "REVIEW_CONTRACT_GAP"
          }
        },
        "required": [
          "status",
          "rule_id",
          "action"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "normative_modified": {
      "const": false
    },
    "production_acceptance": {
      "const": false
    }
  },
  "required": [
    "schema",
    "version",
    "status",
    "evidence_digest",
    "source_sha256",
    "contract_sha256",
    "fixture_sha256",
    "observed",
    "drift",
    "proposed",
    "normative_modified",
    "production_acceptance"
  ],
  "additionalProperties": false
}
