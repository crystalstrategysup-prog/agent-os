{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "function-extractor.method-policy/v1"
    },
    "version": {
      "const": 1,
      "type": "integer"
    },
    "include_prefixes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "maxItems": 160,
      "minItems": 1,
      "uniqueItems": true
    },
    "dispatches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:/-]{0,179}$"
          },
          "provider": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
          },
          "protocol": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*\\.py$"
            },
            "maxItems": 160,
            "minItems": 1,
            "uniqueItems": true
          },
          "callee": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
          },
          "method_arg": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 64
              },
              {
                "type": "null"
              }
            ]
          },
          "method_kw": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "fixed_method": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "provider",
          "protocol",
          "paths",
          "callee",
          "method_arg",
          "method_kw",
          "fixed_method"
        ]
      },
      "maxItems": 256
    },
    "declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:/-]{0,179}$"
          },
          "provider": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
          },
          "protocol": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*\\.py$"
            },
            "maxItems": 160,
            "minItems": 1,
            "uniqueItems": true
          },
          "symbol": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
          }
        },
        "required": [
          "id",
          "provider",
          "protocol",
          "paths",
          "symbol"
        ]
      },
      "maxItems": 256
    }
  },
  "required": [
    "schema",
    "version",
    "include_prefixes",
    "dispatches",
    "declarations"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
