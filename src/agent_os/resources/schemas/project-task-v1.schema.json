{
  "$id": "https://github.com/crystalstrategysup-prog/agent-os/schemas/project-task-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "RECOVERY_REQUIRED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "recovery"
        ]
      }
    }
  ],
  "properties": {
    "answers": {
      "type": "object",
      "properties": {
        "development": {
          "description": "Selected planning/check depth in the existing scoped task context; no authority or readiness grant. Input 1D is normalized to integer 1 before storage.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "scope"
          ],
          "properties": {
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "scope": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "entered_at": {
      "format": "date-time",
      "type": "string"
    },
    "foundation_version": {
      "type": "string"
    },
    "handoff_required": {
      "type": "boolean"
    },
    "handoff_user_home": {
      "type": "string"
    },
    "id": {
      "pattern": "^task-[0-9a-f]{16}$",
      "type": "string"
    },
    "interrupted_continuation": {
      "description": "Nonaccepting interrupted-turn acknowledgement; requires full same-owner entry; retained after consumption.",
      "type": "object"
    },
    "project_id": {
      "type": "string"
    },
    "receipts": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "recovery": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "entered_turn_id": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            "operation_id": {
              "pattern": "^[0-9a-f]{32}$",
              "type": "string"
            },
            "request_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "resumed_revision": {
              "minimum": 1,
              "type": "integer"
            },
            "revision": {
              "minimum": 1,
              "type": "integer"
            },
            "schema": {
              "const": "agentos.refusal-recovery-receipt/v1"
            },
            "state": {
              "enum": [
                "CONSUMED"
              ]
            }
          },
          "required": [
            "schema",
            "operation_id",
            "revision",
            "request_sha256"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "diagnostic_receipt": {
              "additionalProperties": false,
              "properties": {
                "bytes": {
                  "maximum": 16384,
                  "minimum": 1,
                  "type": "integer"
                },
                "path": {
                  "pattern": "^\\.agentos/tasks/task-[0-9a-f]{16}/diagnostics/[0-9a-f]{32}\\.json$",
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "path",
                "bytes",
                "sha256"
              ],
              "type": "object"
            },
            "entered_turn_id": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            "operation_id": {
              "pattern": "^[0-9a-f]{32}$",
              "type": "string"
            },
            "original_attempt_id": {
              "pattern": "^[0-9a-f]{32}$",
              "type": "string"
            },
            "request_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "resumed_revision": {
              "minimum": 1,
              "type": "integer"
            },
            "revision": {
              "minimum": 1,
              "type": "integer"
            },
            "schema": {
              "const": "agentos.refusal-recovery-receipt/v2"
            },
            "state": {
              "enum": [
                "CONSUMED"
              ]
            }
          },
          "required": [
            "schema",
            "operation_id",
            "revision",
            "request_sha256",
            "original_attempt_id",
            "diagnostic_receipt"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "diagnostic_receipt": {
              "additionalProperties": false,
              "properties": {
                "bytes": {
                  "maximum": 16384,
                  "minimum": 1,
                  "type": "integer"
                },
                "path": {
                  "pattern": "^\\.agentos/tasks/task-[0-9a-f]{16}/diagnostics/[0-9a-f]{32}\\.json$",
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "path",
                "bytes",
                "sha256"
              ],
              "type": "object"
            },
            "entered_turn_id": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            "native_origin": {
              "additionalProperties": false,
              "properties": {
                "observation_ref": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,299}$",
                  "type": "string"
                },
                "observation_sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "thread_id": {
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "type": "string"
                },
                "turn_id": {
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "type": "string"
                }
              },
              "required": [
                "thread_id",
                "turn_id",
                "observation_ref",
                "observation_sha256"
              ],
              "type": "object"
            },
            "operation_id": {
              "pattern": "^[0-9a-f]{32}$",
              "type": "string"
            },
            "original_attempt_id": {
              "pattern": "^[0-9a-f]{32}$",
              "type": "string"
            },
            "request_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "resumed_revision": {
              "minimum": 1,
              "type": "integer"
            },
            "revision": {
              "minimum": 1,
              "type": "integer"
            },
            "schema": {
              "const": "agentos.refusal-recovery-receipt/v3"
            },
            "state": {
              "enum": [
                "CONSUMED"
              ]
            }
          },
          "required": [
            "schema",
            "operation_id",
            "revision",
            "request_sha256",
            "original_attempt_id",
            "diagnostic_receipt",
            "native_origin"
          ],
          "type": "object"
        }
      ]
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "schema": {
      "const": "agentos.project-task/v1"
    },
    "selection": {
      "type": "object"
    },
    "session_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "INTAKE",
        "READY",
        "VERIFYING",
        "CLOSED",
        "CHECKPOINT",
        "RECOVERY_REQUIRED",
        "CONTINUATION_REQUIRED"
      ]
    },
    "turn_id": {
      "type": "string"
    },
    "diagnostics": {
      "description": "One-shot diagnostic level 0 overlay, retained in this task. Saved development, task revision, readiness and evidence remain unchanged. Current saved choice wins on return; lifecycle records are not audit acceptance.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "generation",
        "runs"
      ],
      "properties": {
        "schema": {
          "const": "agentos.project-diagnostics/v1"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "runs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "scope",
              "reason",
              "captured_development",
              "status",
              "started_at",
              "started_by"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
              },
              "scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "\\S"
              },
              "captured_development": {
                "$ref": "#/properties/answers/properties/development"
              },
              "status": {
                "enum": [
                  "ACTIVE",
                  "COMPLETED",
                  "CANCELLED"
                ]
              },
              "started_at": {
                "type": "string",
                "format": "date-time"
              },
              "started_by": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "session_id",
                  "turn_id"
                ],
                "properties": {
                  "session_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "\\S"
                  },
                  "turn_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "\\S"
                  }
                }
              },
              "finished_at": {
                "type": "string",
                "format": "date-time"
              },
              "finished_by": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "session_id",
                  "turn_id"
                ],
                "properties": {
                  "session_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "\\S"
                  },
                  "turn_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "\\S"
                  }
                }
              },
              "result": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "summary",
                  "remaining",
                  "next_action",
                  "references"
                ],
                "properties": {
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000,
                    "pattern": "\\S"
                  },
                  "next_action": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "pattern": "\\S"
                  },
                  "remaining": {
                    "type": "array",
                    "maxItems": 32,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000,
                      "pattern": "\\S"
                    }
                  },
                  "references": {
                    "type": "array",
                    "maxItems": 32,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000,
                      "pattern": "\\S"
                    }
                  }
                }
              },
              "resumed_development": {
                "$ref": "#/properties/answers/properties/development"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "ACTIVE"
                    }
                  }
                },
                "then": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "finished_at"
                        ]
                      },
                      {
                        "required": [
                          "finished_by"
                        ]
                      },
                      {
                        "required": [
                          "result"
                        ]
                      },
                      {
                        "required": [
                          "resumed_development"
                        ]
                      }
                    ]
                  }
                },
                "else": {
                  "required": [
                    "finished_at",
                    "finished_by",
                    "result",
                    "resumed_development"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "COMPLETED"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "result": {
                      "properties": {
                        "references": {
                          "minItems": 1
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "required": [
    "schema",
    "id",
    "project_id",
    "created_at",
    "revision",
    "answers",
    "receipts",
    "status",
    "selection",
    "session_id",
    "turn_id",
    "entered_at",
    "foundation_version"
  ],
  "title": "AgentOS project task v1",
  "type": "object"
}
