{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:docs-navigator:input:v1",
  "title": "DN-01.2 explicit selected documentation input",
  "type": "object",
  "properties": {
    "schema": {
      "const": "docs-navigator.input/v1"
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "scope_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "previous": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        }
      },
      "required": [
        "id",
        "created_at",
        "previous"
      ],
      "additionalProperties": false
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      },
      "maxItems": 1000,
      "minItems": 1
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      },
      "maxItems": 200
    },
    "contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contract"
      },
      "maxItems": 1000
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      },
      "maxItems": 2000
    },
    "matrix": {
      "type": "object",
      "properties": {
        "doc": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "doc"
      ],
      "additionalProperties": false
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity_id": {
            "$ref": "#/$defs/id"
          },
          "step_ids": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "maxItems": 1000
          },
          "event_ids": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "maxItems": 1000
          }
        },
        "required": [
          "entity_id",
          "step_ids",
          "event_ids"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/history"
      },
      "maxItems": 2000
    }
  },
  "required": [
    "schema",
    "project",
    "release",
    "documents",
    "modules",
    "contracts",
    "relations",
    "matrix",
    "bindings",
    "history"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,99}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "document": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "kind": {
          "enum": [
            "json",
            "schema",
            "markdown",
            "text",
            "yaml"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "lifecycle": {
          "enum": [
            "current",
            "archived"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2097152
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "readback_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_state": {
          "enum": [
            "FACT",
            "DESIGN",
            "UNKNOWN"
          ]
        },
        "execution": {
          "enum": [
            "NOT_RUN",
            "STATIC_CHECKED",
            "VERIFIED"
          ]
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "operation_id",
            "request_sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "operation_id": {
              "type": "string",
              "pattern": "[0-9a-f]{32}"
            },
            "request_sha256": {
              "type": "string",
              "pattern": "[0-9a-f]{64}"
            }
          }
        }
      },
      "required": [
        "id",
        "title",
        "path",
        "kind",
        "version",
        "lifecycle",
        "sha256",
        "bytes",
        "source_ref",
        "readback_at",
        "evidence_state",
        "execution"
      ],
      "additionalProperties": false
    },
    "module": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "state_owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 1000
        },
        "docs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 1000,
          "minItems": 1
        }
      },
      "required": [
        "id",
        "title",
        "purpose",
        "state_owner",
        "dependencies",
        "docs"
      ],
      "additionalProperties": false
    },
    "parameter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "const": "UNKNOWN",
              "type": "string"
            }
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "required": [
        "name",
        "type",
        "required",
        "description"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "meaning": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "required": [
        "code",
        "meaning"
      ],
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "contract_key": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "lifecycle": {
          "enum": [
            "current",
            "archived"
          ]
        },
        "module": {
          "$ref": "#/$defs/id"
        },
        "state_owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "input": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "output": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          },
          "maxItems": 200
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          },
          "maxItems": 200
        },
        "auth": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 1000
        },
        "usage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "docs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 1000,
          "minItems": 1
        },
        "evidence_state": {
          "enum": [
            "FACT",
            "DESIGN",
            "UNKNOWN"
          ]
        },
        "execution": {
          "enum": [
            "NOT_RUN",
            "STATIC_CHECKED",
            "VERIFIED"
          ]
        }
      },
      "required": [
        "id",
        "contract_key",
        "title",
        "version",
        "lifecycle",
        "module",
        "state_owner",
        "input",
        "output",
        "parameters",
        "errors",
        "auth",
        "dependencies",
        "usage",
        "docs",
        "evidence_state",
        "execution"
      ],
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "uses",
            "implements",
            "emits",
            "consumes",
            "depends_on",
            "describes"
          ]
        },
        "evidence_docs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 1000,
          "minItems": 1
        }
      },
      "required": [
        "from",
        "to",
        "type",
        "evidence_docs"
      ],
      "additionalProperties": false
    },
    "history": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "entity_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 1000
        }
      },
      "required": [
        "id",
        "at",
        "kind",
        "summary",
        "entity_ids"
      ],
      "additionalProperties": false
    }
  }
}
